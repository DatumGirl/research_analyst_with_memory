# Required
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional; defaults live in src/research_analyst/config.py

# Models. The cheap model takes no effort setting unless you name one that supports it.
# RESEARCH_STRONG_MODEL=claude-opus-5-5
# RESEARCH_STRONG_EFFORT=medium
# RESEARCH_CHEAP_MODEL=claude-haiku-4-5
# RESEARCH_CHEAP_EFFORT=
# RESEARCH_JUDGE_MODEL=claude-opus-5-5

# Routing: auto (easy -> cheap, hard -> strong), cheap, or strong
# RESEARCH_ROUTING=auto

# Limits and budgets
# RESEARCH_MAX_TOKENS=16000
# RESEARCH_MAX_SEARCH_RESULTS=5
# RESEARCH_MAX_FETCH_CHARS=20000
# RESEARCH_MAX_TOOL_ROUNDS=6
# RESEARCH_MAX_SUB_QUESTIONS=4
# RESEARCH_MAX_RETRY_ROUNDS=1
# RESEARCH_TOKEN_BUDGET=2000000

# Memory, cache, and storage
# RESEARCH_MEMORY_MAX_AGE_DAYS=30
# RESEARCH_CACHE_TTL_HOURS=24
# RESEARCH_DATA_DIR=.research

# Evaluation
# MLFLOW_TRACKING_URI=sqlite:///.research/mlflow.db
# RESEARCH_MLFLOW_EXPERIMENT=research-analyst
# RESEARCH_REGRESSION_TOLERANCE=0.05
